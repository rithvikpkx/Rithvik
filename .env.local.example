# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# RAG: chat completion model (free-tier-friendly)
DEEPSEEK_API_KEY=

# RAG: embeddings (text-embedding-3-small) and image captioning (gpt-4o-mini)
OPENAI_API_KEY=

# Email allowed to receive admin OTPs. Client-side check on top of Supabase's
# shouldCreateUser=false guard. Public — exposed to the browser bundle.
NEXT_PUBLIC_ADMIN_EMAIL=

# Server-only copy of the same address. This is the one that actually enforces
# authorization: requireAuth() compares the session's email against it, because
# a valid Supabase session only proves *someone* signed in, not that Rithvik
# did. Falls back to NEXT_PUBLIC_ADMIN_EMAIL when unset; if BOTH are unset,
# every server action is refused (fail closed).
ADMIN_EMAIL=

# Inline email composer (Resend HTTP API — https://api.resend.com/emails)
# RESEND_API_KEY is the same kind of key used for Resend SMTP auth; generate in the Resend dashboard.
# All three are server-only (no NEXT_PUBLIC_ prefix).
RESEND_API_KEY=
CONTACT_FROM=contact@rithvik.ai
CONTACT_TO=rithvikpkx@gmail.com
